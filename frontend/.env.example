# ── Local + Vercel ──────────────────────────────────────────────────────────
# On Vercel: Project → Settings → Environment Variables (Production + Preview).
# Root Directory for this monorepo must be: frontend

# Public FastAPI origin (no trailing slash). Never use localhost on Vercel.
# Example: https://api.yourdomain.com   or   https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk — https://dashboard.clerk.com → API Keys
# Add your *.vercel.app (and custom) domains under Clerk → Domains / Configure.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Character map generation (Next.js Route Handlers — runs on Vercel)
# Must support transparent backgrounds; gpt-image-2 does not.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
