# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
GENAI_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# GenAI microservice
GENAI_HOST=0.0.0.0
GENAI_PORT=8001

# LLM / speech providers
# Sarvam: https://dashboard.sarvam.ai  (header: api-subscription-key)
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_STT_MODEL=saaras:v3

# OpenAI: Classroom Director chat fallback, and the lesson guide character map.
# The frontend needs OPENAI_API_KEY too (frontend/.env) to generate characters.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Must support transparent backgrounds; gpt-image-2 does not.
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
